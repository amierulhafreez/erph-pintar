{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Teacher user profile, school identity, license access status, and usage counters",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "Google account email" },
        "displayName": { "type": "string", "description": "Teacher display name" },
        "photoURL": { "type": "string", "description": "Google profile photo URL" },
        "namaSekolah": { "type": "string", "description": "School name" },
        "role": { "type": "string", "enum": ["teacher", "admin"], "description": "User role" },
        "accessStatus": {
          "type": "string",
          "enum": ["pending", "active", "revoked"],
          "description": "Whether the user has unlocked the app with a valid unique access code"
        },
        "accessCodeUsed": {
          "type": "string",
          "description": "The unique access code redeemed by this user"
        },
        "loginCount": { "type": "integer", "description": "Number of logins" },
        "rphGeneratedCount": { "type": "integer", "description": "Total RPHs generated/saved" },
        "lastLoginAt": { "type": "string", "format": "date-time", "description": "Last login timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account first login timestamp" }
      },
      "required": ["uid", "email", "displayName", "role", "loginCount", "rphGeneratedCount", "lastLoginAt", "createdAt"]
    },
    "AccessCodeDoc": {
      "title": "AccessCodeDoc",
      "description": "Individual 1-to-1 unique access code generated by Admin for user monetization and licensing",
      "type": "object",
      "properties": {
        "code": { "type": "string", "description": "Unique uppercase access code (e.g. KIMIA-8F4K2M)" },
        "status": {
          "type": "string",
          "enum": ["unused", "active", "revoked"],
          "description": "Current lifecycle status of the access code"
        },
        "note": { "type": "string", "description": "Admin note such as buyer name, school, or payment reference" },
        "redeemedByUid": { "type": "string", "description": "UID of the teacher who redeemed this code" },
        "redeemedByEmail": { "type": "string", "description": "Email of the teacher who redeemed this code" },
        "redeemedByName": { "type": "string", "description": "Display name of the teacher who redeemed this code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "redeemedAt": { "type": "string", "format": "date-time", "description": "Redemption timestamp" }
      },
      "required": ["code", "status", "note", "createdAt"]
    },
    "SavedRphDoc": {
      "title": "SavedRphDoc",
      "description": "Individual RPH document created and saved by a teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "RPH unique ID" },
        "ownerId": { "type": "string", "description": "Teacher UID who owns this RPH" },
        "ownerEmail": { "type": "string", "format": "email", "description": "Teacher email" },
        "ownerName": { "type": "string", "description": "Teacher name" },
        "namaSekolah": { "type": "string", "description": "School name" },
        "tingkatan": { "type": "string", "description": "Form level (Tingkatan 4 / Tingkatan 5)" },
        "kelas": { "type": "string", "description": "Class name" },
        "babTajuk": { "type": "string", "description": "Chapter title" },
        "skKod": { "type": "string", "description": "Standard Kandungan code" },
        "spKodList": { "type": "string", "description": "Comma-separated SP codes" },
        "modelPdpc": { "type": "string", "description": "PdPC model (Standard KPM / 5E Pedagogi HIKMAH)" },
        "tarikh": { "type": "string", "description": "Lesson date" },
        "rphJson": { "type": "string", "description": "Serialized RPHData JSON payload" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": [
        "id",
        "ownerId",
        "ownerEmail",
        "ownerName",
        "namaSekolah",
        "tingkatan",
        "kelas",
        "babTajuk",
        "skKod",
        "spKodList",
        "modelPdpc",
        "tarikh",
        "rphJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsageLog": {
      "title": "UsageLog",
      "description": "Activity log for logins, code redemptions, RPH generations, AI helper usage, and exports",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User UID" },
        "email": { "type": "string", "format": "email", "description": "User email" },
        "displayName": { "type": "string", "description": "User display name" },
        "namaSekolah": { "type": "string", "description": "School name" },
        "action": {
          "type": "string",
          "enum": ["LOGIN", "AKTIFKAN_KOD", "JANA_RPH", "SIMPAN_RPH", "MUAT_TURUN_WORD", "GUNA_AI"],
          "description": "Type of activity performed"
        },
        "details": { "type": "string", "description": "Summary of the topic/SP/action" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of event" }
      },
      "required": ["uid", "email", "displayName", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Teacher profiles, license status, and usage statistics"
    },
    "/access_codes/{codeId}": {
      "schema": { "$ref": "#/entities/AccessCodeDoc" },
      "description": "Individual unique access codes generated by Admin and redeemed 1-to-1 by users"
    },
    "/rphs/{rphId}": {
      "schema": { "$ref": "#/entities/SavedRphDoc" },
      "description": "Saved RPH documents per teacher"
    },
    "/usage_logs/{logId}": {
      "schema": { "$ref": "#/entities/UsageLog" },
      "description": "Real-time usage and login logs for admin analytics"
    }
  }
}
